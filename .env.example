# ─────────────────────────────────────────────
# Domaine Fendri — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# NE COMMITEZ JAMAIS le fichier .env
# ─────────────────────────────────────────────

# ── Base de données ──────────────────────────
# URI MongoDB Atlas (obligatoire)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fendri

# ── Authentification ─────────────────────────
# Clé secrète pour signer les tokens JWT (obligatoire en production)
JWT_SECRET=changez_cette_valeur_en_production_avec_une_chaine_aleatoire_longue

# ── Paiements Stripe ─────────────────────────
# Clé secrète Stripe (optionnel — requis pour le checkout Stripe)
STRIPE_SECRET_KEY=sk_test_...
# Clé publique Stripe (côté frontend)
VITE_STRIPE_PUBLIC_KEY=pk_test_...
# Secret webhook Stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Paiements Konnect (Tunisie) ──────────────
# Clé API Konnect (optionnel — requis pour le checkout Konnect)
KONNECT_API_KEY=your_konnect_api_key
KONNECT_WALLET_ID=your_konnect_wallet_id

# ── Paiements PayPal ─────────────────────────
# Identifiants PayPal (optionnel — requis pour le checkout PayPal)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Environnement PayPal : "sandbox" ou "production"
PAYPAL_ENV=sandbox

# ── Emails transactionnels (Resend) ──────────
# Clé API Resend (optionnel — pour les emails de confirmation)
# Créez un compte gratuit sur resend.com (100 emails/jour offerts)
RESEND_API_KEY=re_...
# Adresse expéditeur : utilisez "onboarding@resend.dev" pour tester sans domaine vérifié
# En production, vérifiez votre domaine sur resend.com et utilisez votre propre adresse
RESEND_FROM_EMAIL=onboarding@resend.dev
# Email de l'administrateur pour les notifications de commandes
ADMIN_EMAIL=admin@fendri.com

# ── Serveur ──────────────────────────────────
# Port du serveur API (défaut : 3001)
API_PORT=3001
# Environnement : "development" ou "production"
NODE_ENV=development
